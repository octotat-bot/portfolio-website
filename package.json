{
  "name": "mukund-portfolio",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "tokens": "node scripts/build-tokens.mjs",
    "fonts": "node scripts/fetch-effect-fonts.mjs",
    "check:tokens": "node scripts/build-tokens.mjs && node scripts/check-tokens.mjs",
    "dev": "node scripts/build-tokens.mjs && next dev",
    "build": "node scripts/build-tokens.mjs && next build",
    "start": "next start",
    "typecheck": "node scripts/build-tokens.mjs && tsc --noEmit"
  },
  "dependencies": {
    "@paper-design/shaders-react": "0.0.82",
    "lenis": "1.3.27",
    "matter-js": "0.20.0",
    "motion": "14.14.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "@types/matter-js": "0.20.2",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2"
  }
}
